    {
      "name": "Create direct conversation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/conversations/create",
        "body": {
          "mode": "raw",
          "raw": "{\"partnerId\": \"{{idB}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"conversationId\",pm.response.json().conversationId);"
            ]
          }
        }
      ]
    },
    {
      "name": "List conversations A",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": "{{baseUrl}}/api/conversations/get"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Contains A-B conversation\",()=>pm.expect(pm.response.json().some(c=>c.conversationId===pm.collectionVariables.get(\"conversationId\"))).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "List conversations B",
      "request": {
        "method": "GET",
        "header": [
          {
