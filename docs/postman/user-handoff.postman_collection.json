{
  "info": {
    "name": "TV2 user APIs and direct chat integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18081"
    },
    {
      "key": "checkExpiry",
      "value": "false"
    }
  ],
  "item": [
    {
      "name": "Register A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"tenTaiKhoan\": \"User A\", \"userName\": \"check_A_{{suffix}}\", \"email\": \"A_{{suffix}}@example.test\", \"password\": \"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const s = Date.now()+\"_\"+Math.floor(Math.random()*100000);",
              "pm.collectionVariables.set(\"suffix\", s);",
              "pm.collectionVariables.set(\"password\", \"Demo_\"+s+\"!\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"idA\", pm.response.json().id);",
              "pm.test(\"No password hash\",()=>pm.expect(pm.response.json()).not.to.have.property(\"passwordHash\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"userName\": \"check_A_{{suffix}}\", \"password\": \"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"tokenA\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Register B",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"tenTaiKhoan\": \"User B\", \"userName\": \"check_B_{{suffix}}\", \"email\": \"B_{{suffix}}@example.test\", \"password\": \"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"idB\", pm.response.json().id);",
              "pm.test(\"No password hash\",()=>pm.expect(pm.response.json()).not.to.have.property(\"passwordHash\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login B",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"userName\": \"check_B_{{suffix}}\", \"password\": \"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"tokenB\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Update A ignoring B query",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users/me?userId={{idB}}",
        "body": {
          "mode": "raw",
          "raw": "{\"tenTaiKhoan\": \"Updated {{suffix}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Owner is A\",()=>pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"idA\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "B unchanged",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenB}}"
          }
        ],
        "url": "{{baseUrl}}/api/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"B unchanged\",()=>pm.expect(pm.response.json().tenTaiKhoan).to.eql(\"User B\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "A persisted",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": "{{baseUrl}}/api/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Name persisted\",()=>pm.expect(pm.response.json().tenTaiKhoan).to.eql(\"Updated \"+pm.collectionVariables.get(\"suffix\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "Search paginated",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": "{{baseUrl}}/api/users/search?keyword={{suffix}}&page=0&size=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test(\"Two accounts paginated\",()=>{pm.expect(b.totalElements).to.eql(2);pm.expect(b.content.length).to.eql(1);pm.expect(b.totalPages).to.eql(2);});",
              "pm.test(\"Public fields only\",()=>pm.expect(Object.keys(b.content[0]).sort()).to.eql([\"id\",\"tenTaiKhoan\",\"userName\"].sort()));"
            ]
          }
        }
      ]
    },
    {
      "name": "Blank keyword",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": "{{baseUrl}}/api/users/search?keyword=%20"
