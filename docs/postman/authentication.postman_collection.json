{
  "info": {
    "name": "Chat Authentication Stage 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    }
  ],
  "item": [
    {
      "name": "1 Register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix=Date.now()+\"_\"+Math.floor(Math.random()*100000);",
              "pm.collectionVariables.set(\"userName\",\"auth_\"+suffix);",
              "pm.collectionVariables.set(\"email\",\"auth_\"+suffix+\"@example.com\");",
              "pm.collectionVariables.set(\"password\",pm.variables.replaceIn(\"{{$guid}}\"));",
              "pm.collectionVariables.unset(\"accessToken\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201\",()=>pm.response.to.have.status(201));",
              "const b=pm.response.json(); pm.collectionVariables.set(\"userId\",b.id);",
              "pm.test(\"No password\",()=>{pm.expect(b).not.to.have.property(\"passwordHash\");pm.expect(b).not.to.have.property(\"password\");});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenTaiKhoan\": \"Postman Test\",\n  \"email\": \"{{email}}\",\n  \"userName\": \"{{userName}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
    {
      "name": "2 Duplicate register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"409\",()=>pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenTaiKhoan\": \"Postman Test\",\n  \"email\": \"{{email}}\",\n  \"userName\": \"{{userName}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
    {
      "name": "3 Invalid input",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400\",()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenTaiKhoan\": \"\",\n  \"email\": \"invalid\",\n  \"userName\": \"a\",\n  \"password\": \"123\"\n}"
        }
      }
    },
    {
      "name": "4 Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\",()=>pm.response.to.have.status(200));",
              "const b=pm.response.json(); pm.collectionVariables.set(\"accessToken\",b.accessToken);",
              "pm.test(\"Bearer and lifetime\",()=>{pm.expect(b.tokenType).to.eql(\"Bearer\");pm.expect(b.expiresIn).to.be.above(0);});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"{{userName}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
    {
      "name": "5 Me",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Own identity\",()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"userId\"));});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/users/me"
      }
    },
    {
      "name": "6 Me ignores supplied userId",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cannot change identity\",()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"userId\"));});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/users/me?userId=22222222-2222-2222-2222-222222222222"
      }
    },
    {
      "name": "7 Missing token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"401\",()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/users/me"
      }
    },
    {
      "name": "8 Invalid token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"401\",()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "invalid-token",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/users/me"
      }
    },
    {
      "name": "9 Wrong password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"401\",()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"{{userName}}\",\n  \"password\": \"intentionally-wrong-password\"\n}"
        }
      }
    }
  ]
}
