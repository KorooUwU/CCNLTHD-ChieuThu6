{
  "info": {
    "name": "Chat System ? Chapter 9 Integration Tests",
    "description": "Run folders in order against a dev database. C tests access to A-B. Group and Cloudinary are opt-in. Unauthorized access expects 403; current backend may return 400, which is an intentional failing contract check.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "runGroups",
      "value": "false"
    },
    {
      "key": "runCloudinary",
      "value": "false"
    },
    {
      "key": "imagePath",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 ? Authentication",
      "item": [
        {
          "name": "Register User A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"tenTaiKhoan\": \"User A\", \"userName\": \"ch9_A_{{runId}}\", \"email\": \"A_{{runId}}@example.test\", \"password\": \"{{password}}\"}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s=Date.now()+\"_\"+Math.floor(Math.random()*100000);",
                  "pm.collectionVariables.set(\"runId\",s);",
                  "pm.collectionVariables.set(\"password\",\"Test_\"+s+\"!\");",
                  "[\"idA\",\"idB\",\"idC\",\"tokenA\",\"tokenB\",\"tokenC\",\"conversationId\",\"messageId\",\"imageUrl\",\"imagePublicId\",\"imageMessageId\"].forEach(k=>pm.collectionVariables.unset(k));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"idA\",pm.response.json().id);",
                  "pm.test(\"No password hash\",()=>pm.expect(pm.response.json()).not.to.have.property(\"passwordHash\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register User B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"tenTaiKhoan\": \"User B\", \"userName\": \"ch9_B_{{runId}}\", \"email\": \"B_{{runId}}@example.test\", \"password\": \"{{password}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"idB\",pm.response.json().id);",
                  "pm.test(\"No password hash\",()=>pm.expect(pm.response.json()).not.to.have.property(\"passwordHash\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register User C",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"tenTaiKhoan\": \"User C\", \"userName\": \"ch9_C_{{runId}}\", \"email\": \"C_{{runId}}@example.test\", \"password\": \"{{password}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"idC\",pm.response.json().id);",
                  "pm.test(\"No password hash\",()=>pm.expect(pm.response.json()).not.to.have.property(\"passwordHash\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"userName\": \"ch9_A_{{runId}}\", \"password\": \"{{password}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"tokenA\",pm.response.json().accessToken);",
                  "pm.test(\"Bearer token\",()=>{pm.expect(pm.response.json().tokenType).to.eql(\"Bearer\");pm.expect(pm.response.json().accessToken).to.be.a(\"string\").and.not.empty;});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User B",
          "request": {
