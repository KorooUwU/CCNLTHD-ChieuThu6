              "mode": "raw",
              "raw": "{\"partnerId\": \"{{idB}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
                  "pm.test(\"Same conversation\",()=>pm.expect(pm.response.json().conversationId).to.eql(pm.collectionVariables.get(\"conversationId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Conversations A",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/api/conversations/get",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"Contains A-B\",()=>pm.expect(pm.response.json().some(c=>c.conversationId===pm.collectionVariables.get(\"conversationId\"))).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Conversations B",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenB}}"
              }
            ],
            "url": "{{baseUrl}}/api/conversations/get",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"Contains A-B\",()=>pm.expect(pm.response.json().some(c=>c.conversationId===pm.collectionVariables.get(\"conversationId\"))).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Group Conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/conversations/groups",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"groupName\": \"Chapter9 {{runId}}\", \"memberIds\": [\"{{idB}}\"]}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get(\"runGroups\") !== \"true\") pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 ? Messages",
      "item": [
        {
          "name": "Send Text Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/messages",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"conversationId\": \"{{conversationId}}\", \"messageContent\": \"Chapter9 {{runId}}\", \"type\": \"TEXT\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
                  "const b=pm.response.json();pm.collectionVariables.set(\"messageId\",b.messageId);",
                  "pm.test(\"Sender from token\",()=>pm.expect(b.senderId).to.eql(pm.collectionVariables.get(\"idA\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Message History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenB}}"
              }
            ],
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"Contains sent text\",()=>pm.expect(pm.response.json().some(m=>m.messageId===pm.collectionVariables.get(\"messageId\") && m.messageContent===\"Chapter9 \"+pm.collectionVariables.get(\"runId\"))).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Send Empty Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/messages",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"conversationId\": \"{{conversationId}}\", \"messageContent\": \"   \"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Access Unauthorized Conversation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenC}}"
              }
            ],
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\",()=>pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 ? Cloudinary",
      "item": [
        {
          "name": "Upload Image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/api/files/upload",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{imagePath}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get(\"runCloudinary\") !== \"true\") pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
                  "const b=pm.response.json();",
                  "pm.test(\"Cloudinary upload\",()=>{pm.expect(b.url).to.match(/^https:\\/\\//);pm.expect(b.publicId).to.be.a(\"string\").and.not.empty;});",
                  "pm.collectionVariables.set(\"imageUrl\",b.url);pm.collectionVariables.set(\"imagePublicId\",b.publicId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Send Image Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/messages",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"conversationId\": \"{{conversationId}}\", \"type\": \"IMAGE\", \"imageUrl\": \"{{imageUrl}}\", \"attachmentPublicId\": \"{{imagePublicId}}\"}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get(\"runCloudinary\") !== \"true\") pm.execution.skipRequest();",
                  "if(pm.variables.get(\"runCloudinary\")===\"true\" && !pm.collectionVariables.get(\"imageUrl\")) throw new Error(\"Upload must succeed before sending image\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
                  "const b=pm.response.json();pm.collectionVariables.set(\"imageMessageId\",b.messageId);",
                  "pm.test(\"Image persisted in response\",()=>{pm.expect(b.type).to.eql(\"IMAGE\");pm.expect(b.imageUrl).to.eql(pm.collectionVariables.get(\"imageUrl\"));});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Image Message History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenB}}"
              }
            ],
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get(\"runCloudinary\") !== \"true\") pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"Contains uploaded image\",()=>pm.expect(pm.response.json().some(m=>m.messageId===pm.collectionVariables.get(\"imageMessageId\") && m.imageUrl===pm.collectionVariables.get(\"imageUrl\"))).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 ? Negative & Security Tests",
      "item": [
        {
          "name": "Register Duplicate Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"tenTaiKhoan\": \"Duplicate\", \"userName\": \"dup_{{runId}}\", \"email\": \"A_{{runId}}@example.test\", \"password\": \"{{password}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\",()=>pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Invalid Data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"tenTaiKhoan\": \"\", \"email\": \"invalid\", \"userName\": \"x\", \"password\": \"x\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid JWT",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer broken"
              }
            ],
            "url": "{{baseUrl}}/api/users/me",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthorized Message Access",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenC}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/messages",
            "auth": {
              "type": "noauth"
            },
            "body": {
