            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"tokenB\",pm.response.json().accessToken);",
                  "pm.test(\"Bearer token\",()=>{pm.expect(pm.response.json().tokenType).to.eql(\"Bearer\");pm.expect(pm.response.json().accessToken).to.be.a(\"string\").and.not.empty;});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User C",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"userName\": \"ch9_C_{{runId}}\", \"password\": \"{{password}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"tokenC\",pm.response.json().accessToken);",
                  "pm.test(\"Bearer token\",()=>{pm.expect(pm.response.json().tokenType).to.eql(\"Bearer\");pm.expect(pm.response.json().accessToken).to.be.a(\"string\").and.not.empty;});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Invalid Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"userName\": \"ch9_A_{{runId}}\", \"password\": \"incorrect\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 ? User Management",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/me",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"Owner A\",()=>pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"idA\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users/me?userId={{idB}}",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"tenTaiKhoan\": \"Updated {{runId}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"Only A selected\",()=>{pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"idA\"));pm.expect(pm.response.json().tenTaiKhoan).to.eql(\"Updated \"+pm.collectionVariables.get(\"runId\"));});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Updated Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/me",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"Update persisted\",()=>pm.expect(pm.response.json().tenTaiKhoan).to.eql(\"Updated \"+pm.collectionVariables.get(\"runId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify B Unchanged",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenB}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/me",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"B unchanged\",()=>pm.expect(pm.response.json().tenTaiKhoan).to.eql(\"User B\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/search?keyword={{runId}}&page=0&size=2",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "const b=pm.response.json();",
                  "pm.test(\"Pagination\",()=>{pm.expect(b.totalElements).to.eql(3);pm.expect(b.content.length).to.eql(2);});",
                  "pm.test(\"Public fields only\",()=>b.content.forEach(u=>pm.expect(Object.keys(u).sort()).to.eql([\"id\",\"tenTaiKhoan\",\"userName\"].sort())));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Profile Without JWT",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 ? Conversations",
      "item": [
        {
          "name": "Create Direct Conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/conversations/create",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"partnerId\": \"{{idB}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"conversationId\",pm.response.json().conversationId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Duplicate Conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/conversations/create",
            "auth": {
              "type": "noauth"
            },
