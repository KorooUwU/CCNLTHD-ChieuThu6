                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"No message from C\",()=>pm.expect(pm.response.json().some(m=>m.senderId===pm.collectionVariables.get(\"idC\"))).to.eql(false));"
